{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/badfauna/consurf/main/schema/index.schema.json",
  "title": "Consurf open data index",
  "description": "Every convention file in the dataset with its content hash, for change detection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "generatedAt",
    "conventions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": {
      "const": 2
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "conventions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "name",
          "path",
          "sha256",
          "lastModified"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^data/conventions/[a-z0-9-]+\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "lastModified": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
